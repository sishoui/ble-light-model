<!-- 首页（tracer bullet，工单 #16）：扫描 → 连接 → 设灯效。UI 从简，#17 做完整界面。 -->
<view class="page">
  <view class="header">
    <text class="title">BLE Light</text>
    <text class="state state--{{state}}">{{stateText}}</text>
  </view>

  <view class="section">
    <view class="row">
      <button class="btn" bindtap="onScan" loading="{{scanning}}" disabled="{{scanning || connected}}">
        {{scanning ? '扫描中…' : '扫描设备'}}
      </button>
      <button wx:if="{{connected}}" class="btn btn--ghost" bindtap="onDisconnect">断开</button>
    </view>

    <view wx:if="{{devices.length > 0 && !connected}}" class="device-list">
      <view
        wx:for="{{devices}}"
        wx:key="deviceId"
        class="device {{deviceName === item.name ? 'device--active' : ''}}"
        data-device-id="{{item.deviceId}}"
        bindtap="onSelectDevice"
      >
        <text class="device-name">{{item.name}}</text>
        <text class="device-rssi">{{item.rssi}} dBm</text>
      </view>
    </view>
    <view wx:elif="{{!connected && !scanning}}" class="hint">点击"扫描设备"发现 C3（BLELight-C3）</view>
  </view>

  <view wx:if="{{connected}}" class="section">
    <view class="row">
      <text class="section-title">已连接：{{deviceName}}</text>
      <button class="btn btn--small" bindtap="onRefreshStatus">刷新状态</button>
    </view>
    <view wx:if="{{helloText}}" class="info">{{helloText}}</view>
    <view wx:if="{{statusText}}" class="info">{{statusText}}</view>

    <view class="effect-grid">
      <view
        wx:for="{{effects}}"
        wx:key="key"
        class="effect {{selectedEffect === index ? 'effect--active' : ''}}"
        data-index="{{index}}"
        bindtap="onSelectEffect"
      >
        {{item.name}}
      </view>
    </view>

    <view wx:if="{{selectedNeedsColor}}" class="sliders">
      <view class="slider-row">
        <text>R</text>
        <slider min="0" max="255" value="{{colorR}}" activeColor="#ff4444" bindchange="onColorR" />
      </view>
      <view class="slider-row">
        <text>G</text>
        <slider min="0" max="255" value="{{colorG}}" activeColor="#44ff44" bindchange="onColorG" />
      </view>
      <view class="slider-row">
        <text>B</text>
        <slider min="0" max="255" value="{{colorB}}" activeColor="#4444ff" bindchange="onColorB" />
      </view>

      <view wx:if="{{selectedNeedsColor2}}" class="sliders-sub">
        <view class="slider-row">
          <text>R2</text>
          <slider min="0" max="255" value="{{color2R}}" activeColor="#ff4444" bindchange="onColor2R" />
        </view>
        <view class="slider-row">
          <text>G2</text>
          <slider min="0" max="255" value="{{color2G}}" activeColor="#44ff44" bindchange="onColor2G" />
        </view>
        <view class="slider-row">
          <text>B2</text>
          <slider min="0" max="255" value="{{color2B}}" activeColor="#4444ff" bindchange="onColor2B" />
        </view>
      </view>
    </view>

    <button class="btn btn--primary" bindtap="onApply" loading="{{applying}}" disabled="{{applying}}">
      {{applying ? '应用中…' : '应用到整灯带（mask 0xFF）'}}
    </button>
  </view>

  <view class="section">
    <view class="section-title">日志</view>
    <view class="log">
      <view wx:for="{{log}}" wx:key="index" class="log-line">{{item}}</view>
      <view wx:if="{{log.length === 0}}" class="hint">暂无日志</view>
    </view>
  </view>
</view>