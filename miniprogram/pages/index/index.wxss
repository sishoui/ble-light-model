/* 完整控制 UI 样式（工单 #17）。 */
page {
  background: #16213e;
  color: #e8e8e8;
  font-family: -apple-system, "PingFang SC", sans-serif;
}

.page {
  padding: 24rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.state {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #0f3460;
  color: #e8e8e8;
}

.state--ready {
  background: #1b7a43;
}

.state--fault,
.state--reconnecting {
  background: #a83232;
}

.banner {
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  text-align: center;
}

.banner--warn {
  background: #5a3a12;
  color: #ffcc66;
}

.section {
  background: #1f2a4a;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  color: #b8c0d8;
  margin-bottom: 12rpx;
}

.btn {
  background: #0f3460;
  color: #e8e8e8;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0 32rpx;
}

.btn--ghost {
  background: transparent;
  border: 1rpx solid #4a5578;
}

.btn--primary {
  background: #1b7a43;
  width: 100%;
  margin-top: 16rpx;
}

.btn--small {
  font-size: 24rpx;
  padding: 0 24rpx;
}

.btn--tiny {
  font-size: 22rpx;
  padding: 0 20rpx;
}

.btn[disabled] {
  opacity: 0.5;
}

.device-list {
  margin-top: 8rpx;
}

.device {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #27335a;
}

.device--active {
  outline: 2rpx solid #4a90d9;
}

.device-name {
  font-size: 28rpx;
}

.device-rssi {
  font-size: 24rpx;
  color: #8a94b0;
}

.hint {
  font-size: 24rpx;
  color: #8a94b0;
  padding: 12rpx 0;
}

.info {
  font-size: 24rpx;
  color: #b8c0d8;
  margin-bottom: 8rpx;
}

.warn-inline {
  font-size: 22rpx;
  color: #ffcc66;
  padding: 8rpx 0;
}

/* STATUS 网格 */
.status-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.status-cell {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
  font-size: 24rpx;
}

.status-cell .k {
  color: #8a94b0;
}

.status-cell .v {
  color: #e8e8e8;
}

.status-active {
  font-size: 22rpx;
  color: #b8c0d8;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #33406a;
  word-break: break-all;
}

/* strip_mask 灯路选择 */
.mask {
  font-size: 24rpx;
  color: #4a90d9;
}

.lanes {
  display: flex;
  gap: 10rpx;
  margin: 12rpx 0;
}

.lane {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #27335a;
  font-size: 24rpx;
  color: #8a94b0;
}

.lane--on {
  background: #4a90d9;
  color: #fff;
}

.lane-actions {
  justify-content: flex-start;
  gap: 16rpx;
}

/* 灯效网格 */
.effect-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0;
}

.effect {
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  background: #27335a;
  font-size: 26rpx;
}

.effect--active {
  background: #4a90d9;
  color: #fff;
}

/* 滑条 */
.sliders {
  margin: 16rpx 0;
}

.sliders-sub {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #33406a;
}

.sub-title {
  font-size: 22rpx;
  color: #8a94b0;
  margin-bottom: 8rpx;
}

.slider-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.slider-row text {
  width: 96rpx;
  font-size: 24rpx;
  color: #b8c0d8;
}

.slider-row .param-label {
  width: 120rpx;
}

.slider-row slider {
  flex: 1;
}

.slider-val {
  width: 96rpx;
  text-align: right;
  font-size: 24rpx;
  color: #e8e8e8;
}

.limit-row {
  margin-top: 20rpx;
}

.unlock-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 0 8rpx;
}

.unlock-row .param-label {
  font-size: 26rpx;
  color: #b8c0d8;
}

.log {
  font-family: "SF Mono", "Menlo", monospace;
  font-size: 22rpx;
  color: #8a94b0;
  max-height: 360rpx;
  overflow-y: auto;
}

.log-line {
  padding: 4rpx 0;
}