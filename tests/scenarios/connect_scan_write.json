{
  "version": 1,
  "name": "connect_scan_write",
  "description": "冷启动：扫描去重 -> 连接 -> 发现 -> 订阅 -> 写 SET_EFFECT（静态红）-> C3 通知",
  "environment": { "platform": "android", "mtu": 23 },
  "steps": [
    {
      "action": "scan",
      "timeoutMs": 40,
      "script": { "advertiseRepeats": 3 },
      "expect": { "devices": ["C3-A1"] }
    },
    {
      "action": "connect",
      "deviceId": "C3-A1",
      "script": {
        "notifyHex": ["AA550100000100001D01010000083C3075983A4655077F0000000000000000000000000000005CF6"]
      },
      "expect": { "state": "ready" }
    },
    {
      "action": "write",
      "hex": "AA550101000201010401FF0000B521",
      "expect": { "state": "ready", "chunks": [15], "values": ["AA550101000201010401FF0000B521"] }
    },
    {
      "action": "notify",
      "frames": ["AA550102000301FF0180B2E3"],
      "expect": { "notifications": ["AA550102000301FF0180B2E3"] }
    }
  ]
}