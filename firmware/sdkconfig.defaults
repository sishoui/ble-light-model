CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# #7 §1：OTA-ready 分区表（factory 1M + ota_0 1M + ota_1 1M + nvs/otadata/phy）。
# OTA 实现本身 out-of-scope，但分区表现在就上，避免布局变更破坏平滑升级。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# #13 RMT 缓解包（#7 §3）：
# ① 编码函数进 IRAM（rmt_driver.c 的 txe_encode 等带 RMT_ENCODER_FUNC_ATTR）
CONFIG_RMT_ENCODER_FUNC_IN_IRAM=y
# ② RMT TX ISR cache-safe（BLE/WiFi cache 禁用期间补数据不挂）
CONFIG_RMT_TX_ISR_CACHE_SAFE=y
# ③ FreeRTOS tick 1kHz（LED 任务 25ms 周期的 delay 粒度）
CONFIG_FREERTOS_HZ=1000

# #14 BLE（NimBLE + GATT server，#7 §5）：
# NimBLE host 角色外设；MTU 被动跟随（PC/安卓侧发起协商），这里给大值。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256